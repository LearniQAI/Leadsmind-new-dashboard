#!/bin/sh
# Only runs the Container display-prop check when a template file is actually staged, so
# unrelated commits aren't slowed down by it. Installed automatically via `npm install`'s
# `prepare` script (see scripts/setup-git-hooks.js) — no manual husky-style setup needed.

staged_templates=$(git diff --cached --name-only --diff-filter=ACM -- 'src/lib/builder/templates/*.ts')

if [ -z "$staged_templates" ]; then
  exit 0
fi

echo "Checking staged builder templates for the Container display-prop footgun..."
npm run --silent validate:templates
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Commit blocked: fix the violation(s) above, or see scripts/validate-container-flex-props.js for why this check exists."
fi

exit $status
