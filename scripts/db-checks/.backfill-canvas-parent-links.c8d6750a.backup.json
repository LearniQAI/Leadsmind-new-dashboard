    "type": {
     "resolvedName": "Paragraph"
    },
    "nodes": [],
    "props": {
     "text": "In this quick module, we'll explore:",
     "color": "#374151",
     "fontSize": 16,
     "className": "font-inter",
     "textAlign": "left",
