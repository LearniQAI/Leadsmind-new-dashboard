   "lead2": {
    "type": {
     "resolvedName": "Paragraph"
    },
    "nodes": [],
    "props": {
     "text": "To really benefit from this module, I encourage you to do three things:",
     "color": "#374151",
     "fontSize": 16,
     "className": "font-inter",
     "textAlign": "left",
     "fontWeight": "normal",
